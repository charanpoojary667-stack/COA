#include <stdio.h>
#include <string.h>

int main()
{
    char b[100];
    int i;

    printf("Enter binary number: ");
    scanf("%s", b);

    for (i = 0; b[i]; i++)
        b[i] = b[i] == '0' ? '1' : '0';

    for (i = strlen(b) - 1; i >= 0 && b[i] == '0'; i--)
        b[i] = '1';

    if (i >= 0)
        b[i] = '0';

    printf("2's complement: %s", b);

    return 0;
}
