.MODEL SMALL
.STACK 100H

.DATA
A DB ?
B DB ?

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    MOV AH, 01H
    INT 21H
    SUB AL, 30H
    MOV A, AL

    MOV AH, 01H
    INT 21H
    SUB AL, 30H
    MOV B, AL

    MOV AL, A
    ADD AL, B

    MOV AL, A
    SUB AL, B

    MOV AL, A
    MUL B

    MOV AL, A
    MOV AH, 00H
    DIV B

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
