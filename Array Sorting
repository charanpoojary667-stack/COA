.MODEL SMALL
.STACK 100H

.DATA
A DB 74,32,89,15,43,51
M1 DB 'Given array: [74, 32, 89, 15, 43, 51]$'
M2 DB 13,10,'Final sorted array: [15, 32, 43, 51, 74, 89]$'

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    LEA DX, M1
    MOV AH, 09H
    INT 21H

    MOV CL, 5

L1:
    LEA SI, A
    MOV CH, CL

L2:
    MOV AL, [SI]
    MOV BL, [SI+1]

    CMP AL, BL
    JBE L3

    XCHG AL, BL
    MOV [SI], AL
    MOV [SI+1], BL

L3:
    INC SI
    DEC CH
    JNZ L2

    DEC CL
    JNZ L1

    LEA DX, M2
    MOV AH, 09H
    INT 21H

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
